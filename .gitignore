~$*
outputs/**/node_modules/
outputs/**/*_preview.png
outputs/**/*.inspect.ndjson
outputs/**/build_workbook.mjs
*.tmp
*.temp
*.zip
__pycache__/
*.py[cod]
.DS_Store
Thumbs.db

# Local analysis dependencies and disposable rendering files.
outputs/**/python_deps/
outputs/**/qa_deps/
outputs/**/*.whl
tmp/
# Superseded generated CAD pose; the approved revised STEP is external input.
outputs/left_arm_step_analysis/left_arm_photo_pose_candidate.step
# Generated camera/CAD arrays and media stay in the indexed local/Jetson archive.
outputs/**/*.npy
outputs/**/*.npz
outputs/**/*.jpg
outputs/**/*.png
outputs/**/*.mp4

# Nov2 experiment evidence is intentionally versioned for research reproducibility.
!outputs/board_drift_20261102/**/*.jpg
!outputs/board_drift_20261102/**/*.png
!outputs/board_drift_20261102/**/*.npy
!outputs/board_drift_20261102/**/*.npz
!outputs/board_drift_20261102/raw_evidence/chunks/*.bin
!outputs/board_drift_20261102/figures/*.mp4
outputs/board_drift_20261102/restored_dataset/

# Private Mac migration snapshot includes chat history and personal attachments.
outputs/mac_handoff_20261107/

# Nov8 rolling dynamics log exceeds GitHub's per-file limit; retained losslessly
# in the checksum-indexed control archive and final runtime Release assets.
outputs/a7_repeat_20261108/control_evidence/rolling_logs/left_arm_general_motion_runs.jsonl
